---
interface Props {
  name: string;
}
const { name } = Astro.props;
---

<span class="service-icon" aria-hidden="true">
  {name === 'phone' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <rect x="6" y="2" width="12" height="20" rx="2"></rect>
      <line x1="11" y1="18" x2="13" y2="18"></line>
    </svg>
  )}
  {name === 'tv' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <rect x="2" y="4" width="20" height="14" rx="2"></rect>
      <line x1="8" y1="22" x2="16" y2="22"></line>
      <line x1="12" y1="18" x2="12" y2="22"></line>
    </svg>
  )}
  {name === 'laptop' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <rect x="4" y="4" width="16" height="11" rx="1"></rect>
      <path d="M2 19h20l-1.5-3.5h-17L2 19z"></path>
    </svg>
  )}
  {name === 'pc' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <rect x="4" y="3" width="16" height="12" rx="1"></rect>
      <line x1="8" y1="21" x2="16" y2="21"></line>
      <line x1="12" y1="15" x2="12" y2="21"></line>
    </svg>
  )}
  {name === 'kettle' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 10a7 7 0 0 1 14 0v6a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3v-6z"></path>
      <path d="M9 3v3M15 3v3M18 12h3M2 19h20"></path>
    </svg>
  )}
  {name === 'vacuum' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="8" cy="18" r="3"></circle>
      <path d="M8 15V8a4 4 0 0 1 4-4h1"></path>
      <path d="M13 4h5a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2h-2"></path>
    </svg>
  )}
  {name === 'iron' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 8c0-2.5-2.5-4-6-4H9a5 5 0 0 0-5 5v2c0 3 2 6 6 6h4l4-3.5C19.2 12.4 20 10.4 20 8z"></path>
      <line x1="6" y1="20" x2="16" y2="20"></line>
    </svg>
  )}
  {name === 'mixer' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M7 2h6l-1 8h-4L7 2z"></path>
      <path d="M9 10v4a5 5 0 0 0 5 5h1"></path>
      <circle cx="16" cy="19" r="2"></circle>
    </svg>
  )}
  {name === 'microwave' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <rect x="2" y="6" width="20" height="12" rx="1.5"></rect>
      <rect x="4.5" y="8.5" width="10" height="7" rx="0.5"></rect>
      <line x1="18" y1="10" x2="19.5" y2="10"></line>
      <line x1="18" y1="13" x2="19.5" y2="13"></line>
    </svg>
  )}
  {name === 'toaster' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="6" width="18" height="12" rx="2"></rect>
      <path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"></path>
      <line x1="8" y1="10" x2="8" y2="14"></line>
      <line x1="16" y1="10" x2="16" y2="14"></line>
    </svg>
  )}
  {name === 'fan' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="1.6"></circle>
      <path d="M12 10.4C12 6 9 3 6 4c-1.5 1 -1 4.5 3 6.6"></path>
      <path d="M13.6 12C18 12 21 9 20 6c-1-1.5-4.5-1-6.6 3"></path>
      <path d="M12 13.6C12 18 15 21 18 20c1.5-1 1-4.5-3-6.6"></path>
      <path d="M10.4 12C6 12 3 15 4 18c1 1.5 4.5 1 6.6-3"></path>
    </svg>
  )}
  {(name === 'other' || !['phone','tv','laptop','pc','kettle','vacuum','iron','mixer','microwave','toaster','fan'].includes(name)) && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14.7 6.3a4 4 0 0 1-5.4 5.4L4 17l3 3 5.3-5.3a4 4 0 0 1 5.4-5.4l-2.3 2.3-2-2 2.3-2.3z"></path>
    </svg>
  )}
</span>

<style>
  .service-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--accent);
    margin-bottom: 12px;
    flex-shrink: 0;
  }
  .service-icon svg { width: 20px; height: 20px; }
</style>
